---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  const ordenadas = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return ordenadas.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      anterior: ordenadas[i + 1] ?? null,
      siguiente: ordenadas[i - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  anterior: CollectionEntry<'posts'> | null;
  siguiente: CollectionEntry<'posts'> | null;
}

const { post, anterior, siguiente } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const parrafos = post.body.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const corte = Math.min(2, parrafos.length);
const primeros = parrafos.slice(0, corte);
const restantes = parrafos.slice(corte);
---
<BaseLayout
  title={`${post.data.title} — El simio informado`}
  description={post.data.excerpt}
  image={post.data.image}
  type="article"
  publishedDate={post.data.date}
>
  <article class="post-detail">
    <a href="/" class="back-link">&larr; Volver a portada</a>

    {post.data.image && (
      <div class="post-detail__banner">
        <img src={post.data.image} alt={post.data.title} width="1344" height="768" />
      </div>
    )}

    <span class="cartela">
      <time datetime={post.data.date.toISOString()}>
        {dateFormatter.format(post.data.date)}
      </time>
      {post.data.category && ` · ${post.data.category}`}
    </span>

    <h1 class="post-detail__title">{post.data.title}</h1>

    <p class="post-detail__excerpt">{post.data.excerpt}</p>

    <div class="post-detail__body">
      {primeros.map((p) => <p>{p}</p>)}

      {post.data.bodyImage && (
        <figure class="post-body-figure">
          <img
            src={post.data.bodyImage}
            alt={post.data.bodyCaption ?? post.data.title}
            width="1344"
            height="768"
          />
          {post.data.bodyCaption && (
            <figcaption>
              <span class="lamina">Lám. I</span>{post.data.bodyCaption}
            </figcaption>
          )}
        </figure>
      )}

      {restantes.map((p) => <p>{p}</p>)}
    </div>

    {(anterior || siguiente) && (
      <nav class="post-nav">
        {anterior && (
          <a class="post-nav__link" href={`/posts/${anterior.slug}/`}>
            <span class="post-nav__label">Noticia anterior</span>
            {anterior.data.title}
          </a>
        )}
        {siguiente && (
          <a class="post-nav__link post-nav__link--next" href={`/posts/${siguiente.slug}/`}>
            <span class="post-nav__label">Noticia siguiente</span>
            {siguiente.data.title}
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>