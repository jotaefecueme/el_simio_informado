---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout
  title="El Simio Informado — Noticias reales, contadas por monos"
  image={posts[0]?.data.image}
>
  {posts.length === 0 ? (
    <p class="empty-state">Todavía no hay noticias publicadas. Vuelve pronto.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post, i) => (
        <li>
          <a class="post-card" href={`/posts/${post.slug}/`}>
            <div class="post-card__banner">
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt=""
                  loading={i < 2 ? 'eager' : 'lazy'}
                  width="1344"
                  height="768"
                />
              )}
            </div>
            <span class="post-card__tag">
              <time datetime={post.data.date.toISOString()}>
                {dateFormatter.format(post.data.date)}
              </time>
              {post.data.category && ` · ${post.data.category}`}
            </span>
            <h2 class="post-card__title">{post.data.title}</h2>
            <p class="post-card__excerpt">{post.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>