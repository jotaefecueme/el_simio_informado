---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Noticias reales, contadas por monos.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href="/" class="site-title">El simio informado</a>
        <span class="site-tagline">Simio no mata simio</span>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        El simio informado &mdash; noticias reales, contadas por monos.
      </div>
    </footer>
  </body>
</html>
